body {
  background: linear-gradient(135deg, #caa327, #9966cc, #9acd66) !important;
  background-attachment: fixed !important;
}

.logo img {
  height: 110px !important;
  width: auto !important;
}

/* Cosmic dimensional video background */
html {
    background: #000000;
}

body {
    position: relative;
    background: transparent !important;
}

.header,
.main,
.footer,
.top-link {
    position: relative;
    z-index: 3;
}

#cosmic-bg-video {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100vw;
    height: 100vh;
    object-fit: cover;
    object-position: center;
    pointer-events: none;
}

#cosmic-bg-overlay {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(
        circle at center,
        rgba(0, 0, 0, 0.35) 0%,
        rgba(0, 0, 0, 0.65) 70%,
        rgba(0, 0, 0, 0.85) 100%
    );
}

.lvl7-cosmic-mark {
    position: fixed;
    inset: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    pointer-events: none;

    color: #d8c56c;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.5rem, 12vw, 12rem);
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1;
    white-space: nowrap;

    text-shadow:
        0 0 8px #ffffff,
        0 0 20px #9a5bd7,
        0 0 42px #a6d45e,
        0 0 78px #d8c56c;

    animation: lvl7-float 7s ease-in-out infinite;
}

@keyframes lvl7-float {
    0%, 100% {
        transform: translateY(0) scale(1);
        opacity: 0.9;
    }
    50% {
        transform: translateY(-14px) scale(1.035);
        opacity: 1;
    }
}

@media (prefers-reduced-motion: reduce) {
    #cosmic-bg-video {
        display: none;
    }
    .lvl7-cosmic-mark {
        animation: none;
    }
    html {
        background: #000000;
    }
}

@media (max-width: 600px) {
    .lvl7-cosmic-mark {
        font-size: clamp(2.5rem, 16vw, 6rem);
    }
}

/* Global text color override */
body,
p,
h1, h2, h3, h4, h5, h6,
li,
span,
a,
.logo,
.post-content,
.menu,
.footer {
  color: #9966cc !important;
}

/* Green outline on all text */
body,
p,
h1, h2, h3, h4, h5, h6,
li,
span,
a,
.logo,
.post-content,
.menu,
.footer {
  text-shadow:
    -1px -1px 0 #9acd66,
     1px -1px 0 #9acd66,
    -1px  1px 0 #9acd66,
     1px  1px 0 #9acd66,
     0px  1px 0 #9acd66,
     0px -1px 0 #9acd66,
     1px  0px 0 #9acd66,
    -1px  0px 0 #9acd66;
}

.post-content::before,
.post-entry::before,
article.post-single::before,
.first-entry::before,
main::before {
    content: "";
    position: absolute;
    top: 0%;
    left: 0%;
    width: 100%;
    height: 100%;
    background: rgba(202, 163, 39, 0.6);
    box-shadow: 0 0 50px rgba(202, 163, 39, 0.7);
    -webkit-clip-path: polygon(20% 0%, 80% 5%, 100% 35%, 95% 75%, 70% 100%, 30% 95%, 5% 65%, 0% 25%);
    clip-path: polygon(20% 0%, 80% 5%, 100% 35%, 95% 75%, 70% 100%, 30% 95%, 5% 65%, 0% 25%);
    z-index: -1;
    animation: float-shape 8s ease-in-out infinite, morph-shape 12s ease-in-out infinite;
    will-change: clip-path, transform;
}

@keyframes float-shape {
    0%, 100% {
        transform: translateY(0px) rotate(0deg);
    }
    50% {
        transform: translateY(-18px) rotate(1.5deg);
    }
}

@keyframes morph-shape {
    0%, 100% {
        -webkit-clip-path: polygon(20% 0%, 80% 5%, 100% 35%, 95% 75%, 70% 100%, 30% 95%, 5% 65%, 0% 25%);
        clip-path: polygon(20% 0%, 80% 5%, 100% 35%, 95% 75%, 70% 100%, 30% 95%, 5% 65%, 0% 25%);
    }
    33% {
        -webkit-clip-path: polygon(10% 10%, 70% 0%, 100% 20%, 90% 90%, 60% 100%, 15% 85%, 0% 50%, 5% 20%);
        clip-path: polygon(10% 10%, 70% 0%, 100% 20%, 90% 90%, 60% 100%, 15% 85%, 0% 50%, 5% 20%);
    }
    66% {
        -webkit-clip-path: polygon(25% 5%, 90% 15%, 95% 60%, 75% 95%, 40% 100%, 10% 80%, 0% 40%, 15% 10%);
        clip-path: polygon(25% 5%, 90% 15%, 95% 60%, 75% 95%, 40% 100%, 10% 80%, 0% 40%, 15% 10%);
    }
}

